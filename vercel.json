{
  "proxy": {
    "entrypoint": "middleware.js"
  },
  "services": {
    "home": {
      "root": "apps/home",
      "installCommand": "echo skip",
      "buildCommand": "node build.mjs",
      "outputDirectory": "dist"
    },
    "math": {
      "root": "apps/math",
      "framework": "vite",
      "installCommand": "npm install --prefix ../..",
      "buildCommand": "npm run build",
      "rewrites": [
        {
          "source": "/math",
          "destination": "/index.html"
        },
        {
          "source": "/math/",
          "destination": "/index.html"
        },
        {
          "source": "/math/:path(.*)",
          "destination": "/:path"
        }
      ]
    },
    "reading": {
      "root": "apps/reading",
      "framework": "vite",
      "installCommand": "npm install --prefix ../..",
      "buildCommand": "npm run build",
      "rewrites": [
        {
          "source": "/reading",
          "destination": "/index.html"
        },
        {
          "source": "/reading/",
          "destination": "/index.html"
        },
        {
          "source": "/reading/:path(.*)",
          "destination": "/:path"
        }
      ]
    },
    "adventure": {
      "root": "apps/adventure",
      "framework": "nextjs",
      "installCommand": "npm install --prefix ../.."
    }
  },
  "rewrites": [
    {
      "source": "/math",
      "destination": {
        "service": "math"
      }
    },
    {
      "source": "/math/(.*)",
      "destination": {
        "service": "math"
      }
    },
    {
      "source": "/reading",
      "destination": {
        "service": "reading"
      }
    },
    {
      "source": "/reading/(.*)",
      "destination": {
        "service": "reading"
      }
    },
    {
      "source": "/adventure",
      "destination": {
        "service": "adventure"
      }
    },
    {
      "source": "/adventure/(.*)",
      "destination": {
        "service": "adventure"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "home"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "home"
      }
    }
  ]
}
